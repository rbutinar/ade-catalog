/// Customer dimension - Acme Manufacturing customers from Databricks gold layer
table DimCustomer
	lineageTag: bd92c488-9530-4a14-a24a-73f35ce57e02

	/// Total number of customers in the dimension
	measure 'Total Customers' = COUNTROWS(DimCustomer)
		formatString: #,##0
		lineageTag: d1a2b3c4-e5f6-7890-abcd-100000000001

	/// Customers with active status
	measure 'Active Customers' = CALCULATE(COUNTROWS(DimCustomer), DimCustomer[fl_is_active] = TRUE)
		formatString: #,##0
		lineageTag: d1a2b3c4-e5f6-7890-abcd-100000000002

	/// Percentage of customers that are active
	measure 'Customer Retention Rate' = DIVIDE([Active Customers], [Total Customers], 0)
		formatString: 0.0%
		lineageTag: d1a2b3c4-e5f6-7890-abcd-100000000003

	/// Average customer lifetime value
	measure 'Average LTV' = AVERAGE(DimCustomer[nr_lifetime_value])
		formatString: $ #,##0.00
		lineageTag: d1a2b3c4-e5f6-7890-abcd-100000000004

	/// Revenue divided by active customers
	measure 'Revenue per Customer' = DIVIDE([Total Revenue], [Active Customers], 0)
		formatString: $ #,##0.00
		lineageTag: d1a2b3c4-e5f6-7890-abcd-100000000005

	column cd_customer
		dataType: string
		lineageTag: b39e539c-f534-471f-abc7-51554195fe93
		summarizeBy: none
		sourceColumn: cd_customer
		isKey

		annotation SummarizationSetBy = Automatic

