		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition DimCustomer = m
		mode: import
		source =
				let
				    Source = Databricks.Catalogs("dbc-da799c8c-f5df.cloud.databricks.com", "/sql/1.0/warehouses/98498de391bacdc0", [Catalog="workspace", Database="default"]),
				    gold_dm_customer = Source{[Schema="default",Item="gold_dm_customer"]}[Data]
				in
				    gold_dm_customer

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
